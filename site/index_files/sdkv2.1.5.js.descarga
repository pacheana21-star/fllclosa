    };

    iDiv.insertAdjacentHTML(
      "afterbegin",
      `<div style="width: 100%; height: 100%; box-sizing: border-box; padding: 4px 24px; background: linear-gradient(231deg, var(--alan-fab-bg-start) 0%, var(--alan-fab-bg-end) 100%); box-shadow: 0px 12px 24px rgba(0, 33.69, 84.22, 0.06); border-radius: 40px; outline: 1px var(--alan-fab-outline) solid; outline-offset: -1px; justify-content: center; align-items: center; gap: 12px; display: inline-flex">
        <div class="float-button-icon">
          ${AlanChat.floatAvatarUrl ? `<img style="box-shadow: 0px 16px 24px rgba(51.28, 5.64, 106.84, 0.07); border-radius: 9999px; overflow: hidden;" src="${AlanChat.floatAvatarUrl}" />` : ""}
        </div>
        <div id="alanFloatButtonTitle" style="justify-content: center; display: flex; flex-direction: column; color: var(--alan-fab-text-color); font-size: 14px; font-weight: 500; line-height: 20px; word-wrap: break-word">${AlanChat.title}</div>
      </div>`,
    );

    if (!AlanChat.floatAvatarUrl) {

      const customizedAnimation = customizeOrbAnimation(
        animationFloatAvatar,
        getComputedStyle(document.documentElement).getPropertyValue("--alan-color-acent") || "#3B82F6",
      );

      const loadAnimation = () => {
        lottie.loadAnimation({
          container: iDiv.querySelector(".float-button-icon"),
          renderer: "svg",
          loop: true,
          autoplay: true,
          animationData: customizedAnimation,
        });
      };

      if (typeof lottie === "undefined") {
        if (!AlanChat._lottieLoading) {
          AlanChat._lottieLoading = true;
          const script = document.createElement("script");
          script.src =
            "https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.13.0/lottie.min.js";
          script.integrity =
            "sha512-uOtp2vx2X/5+tLBEf5UoQyqwAkFZJBM5XwGa7BfXDnWR+wdpRvlSVzaIVcRe3tGNsStu6UMDCeXKEnr4IBT8gA==";
          script.crossOrigin = "anonymous";
          script.referrerPolicy = "no-referrer";
          script.onload = loadAnimation;
          document.head.appendChild(script);
        }
      } else {
        loadAnimation();
      }
    }
  }

  baseElement.appendChild(iDiv);

  const iDivChat = createDiv("alanChat");

  const iDivHeaderTitle = document.createElement("h3");
  iDivHeaderTitle.id = "alanHeaderText";

  const iDivHeader = createDiv("alanHeaderButton");

  const iDivContent = createDiv("alanChatContent", "alan_chat_content");

  if (AlanChat.buttonHidden) {
    try {
      document
        .getElementById("alanActionButton")
        .style.setProperty("display", "none");
    } catch (ex) {
      try {
        document
          .getElementById("alanHeaderButton")
          .style.setProperty("display", "none");
      } catch (ex) { }
    }
    baseElement.classList.add("alan_button_hidden");
  }

  {
    var isDragging = false;
    var initialX, initialY, offsetX, offsetY;

    const element = document.getElementById("alanActionButton");

    // Touch drag (mobile)
    if (usingIconFabMobile()) {
      var touchHasMoved = false;

      element.addEventListener(
        "touchstart",
        (e) => {
          isDragging = true;
          touchHasMoved = false;
          var touch = e.touches[0];
          initialX = touch.clientX;
          initialY = touch.clientY;
          const rect = element.getBoundingClientRect();
          offsetX = rect.left;
          offsetY = rect.top;
          element.style.transition = "none";
          document.body.style.overflow = "hidden";
          document.body.classList.add("scroll-lock");
        },
        { passive: false },
      );

      document.addEventListener(
        "touchmove",
        (e) => {
          if (!isDragging) return;
          var touch = e.touches[0];
          const deltaX = touch.clientX - initialX;
          const deltaY = touch.clientY - initialY;

          if (!touchHasMoved) {
            touchHasMoved = true;
            element.style.right = "auto";
            element.style.bottom = "auto";
            element.style.left = offsetX + "px";
            element.style.top = offsetY + "px";
          }

          element.style.left = offsetX + deltaX + "px";
          element.style.top = offsetY + deltaY + "px";
          e.preventDefault();
        },
        { passive: false },
      );

      document.addEventListener("touchend", () => {
        isDragging = false;
        positionX = element.style.left;
        positionY = element.style.top;
        positionMode = "left-top";
        element.style.transition = "";
        document.body.style.overflow = "auto";
        document.body.classList.remove("scroll-lock");
      });
    }

    // Mouse drag (desktop) — independent of fabType
    if (AlanChat.draggable) {
      var hasMoved = false;

      element.addEventListener("mousedown", (e) => {
        isDragging = true;
        hasMoved = false;
        initialX = e.clientX;
        initialY = e.clientY;
        const rect = element.getBoundingClientRect();
        offsetX = rect.left;
        offsetY = rect.top;
        element.style.transition = "none";
        e.preventDefault();
      });

      document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        const deltaX = e.clientX - initialX;
        const deltaY = e.clientY - initialY;
        if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) {
          if (!hasMoved) {
            hasMoved = true;
            element.style.right = "auto";
            element.style.bottom = "auto";
            element.style.left = offsetX + "px";
            element.style.top = offsetY + "px";
          }
          element.style.left = offsetX + deltaX + "px";
          element.style.top = offsetY + deltaY + "px";
        }
      });

      document.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        // Convert left/top to right/bottom so position adapts on window resize
        // Clamp to 0 to prevent negative values when dragged outside viewport
        var rect = element.getBoundingClientRect();
        var newRight = Math.max(0, window.innerWidth - rect.right);
        var newBottom = Math.max(0, window.innerHeight - rect.bottom);
        element.style.left = "auto";
        element.style.top = "auto";
        element.style.right = newRight + "px";
        element.style.bottom = newBottom + "px";
        positionX = element.style.right;
        positionY = element.style.bottom;
        positionMode = "right-bottom";
        element.style.transition = "";
      });

      document.addEventListener("click", (e) => {
        if (hasMoved && (e.target === element || element.contains(e.target))) {
          e.stopImmediatePropagation();
          hasMoved = false;
        }
      }, true);
    }
  }

  AlanChat.loadIframe = function () {
    if (baseElement.contains(iDiv)) {
      const rect = iDiv.getBoundingClientRect();
      if (positionMode === "right-bottom") {
        positionX = iDiv.style.right || (window.innerWidth - rect.right) + "px";
        positionY = iDiv.style.bottom || (window.innerHeight - rect.bottom) + "px";
      } else {
        positionX = iDiv.style.left || rect.left + "px";
        positionY = iDiv.style.top || rect.top + "px";
      }

      if (AlanChat.theme === "default-legacy") {
        iDiv.style.setProperty("display", "none");
      } else if (usingIconFab() && !isMobile.any()) {
        iDiv.style.zIndex = "1000000";
      }
    }

    iDivChat.className = "alan_chat_body";
    const useIconFabHide = usingIconFab() && AlanChat.theme === "default-legacy";
    iDivChat.innerHTML =
      '<iframe #iframeId onload="AlanChat._onload()" class="webchat-iframe' +
      (useIconFabHide ? ' webchat-iframe-hide' : '') +
      '" src="' + AlanChat.url + '"></iframe>';

    // Header
    iDivHeader.className = "alan_chat_header";

    if (AlanChat.theme === "default-legacy") {
      iDivHeaderTitle.innerHTML = AlanChat.title;

      iDivHeader.appendChild(iDivHeaderTitle);
      iDivHeader.insertAdjacentHTML(
        "beforeend",
        '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24"><path d="M0 0h24v24H0z" fill="none"/><path d="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"/></svg>',
      );
    }

    if (AlanChat.theme === "default-new") {
      if (getVW() > 480) {
        iDivContent.style.right = AlanChat.right;
        iDivContent.style.bottom = `${iDiv.offsetHeight + 16 + parseInt(AlanChat.bottom)}px`;
      }

      const headerLogo = AlanChat.headerLogoUrl
        ? `<img src="${AlanChat.headerLogoUrl}" style="max-height: 40px; width: auto;" />`
        : "";

      iDivHeader.innerHTML = `
        <div
          style="width: 100%; height: 70px; box-sizing: border-box; padding-left: 16px; padding-right: 16px; padding-top: 4px; padding-bottom: 4px; position: relative; overflow: hidden; justify-content: center; align-items: center; gap: 10px; display: flex">
          <div
            class="AlanChat-headerLogo"
            style="flex: 1 1 0; flex-direction: column; justify-content: center; align-items: center; gap: 10px; display: inline-flex">
            ${headerLogo}
          </div>
          <div
            class="AlanChat-backButton"
            style="display: flex;align-items: center;justify-content: center; width: 36px; height: 36px; left: 18px; top: 50%; transform: translateY(-50%); position: absolute; background: linear-gradient(90deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.60) 100%); border-radius: 40px; backdrop-filter: blur(17.25px)">
            <div data-color="Default" data-size="LG"
              style="display: flex;align-items: center;justify-content: center; width: 22px; height: 22px; opacity: 0.60; overflow: hidden">
              <svg width="17" height="12" viewBox="0 0 17 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M5.79167 0.75L0.866565 5.674C0.788854 5.75037 0.75 5.85046 0.75 5.95056M5.79167 10.8333L0.866565 6.22711C0.788854 6.15074 0.75 6.05065 0.75 5.95056M0.75 5.95056H15.4167"
                  stroke="#000F2A" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </div>
          </div>
          <div
            class="AlanChat-closeButton"
            style="align-items: center;justify-content: center; width: 36px; height: 36px; right: 18px; top: 50%; transform: translateY(-50%); position: absolute; background: linear-gradient(90deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.60) 100%); border-radius: 40px; backdrop-filter: blur(17.25px); cursor: pointer;">
            <div style="display: flex;align-items: center;justify-content: center; width: 22px; height: 22px; opacity: 0.60; overflow: hidden">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L13 13M13 1L1 13" stroke="#000F2A" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </div>
          </div>
        </div>`;
    }

    iDivContent.className = "alan_chat_content";
    iDivContent.appendChild(iDivHeader);
    iDivContent.appendChild(iDivChat);

    if (useIconFabHide) {
      iDivContent.classList.add("alan_chat_hide");
      iDivContent.classList.add("alan_hide_mobile");
    }

    baseElement.appendChild(iDivContent);

    // Tablet keyboard fix: reposition widget above virtual keyboard.
    // Uses visualViewport resize on the parent page to detect keyboard.
    (function tabletKeyboardFix() {
      if (getVW() <= 480) return;
      if (!window.matchMedia("(hover: none) and (pointer: coarse)").matches) return;

      var vv = window.visualViewport;
      if (!vv) return;

      var origBottom = iDivContent.style.bottom || "32px";
      var keyboardOpen = false;
      var restoreTimer = null;
      var resizeTimer = null;
      var lastKbH = 0;

      function moveUp(kbH) {
        keyboardOpen = true;
        lastKbH = kbH;
        clearTimeout(restoreTimer);
        iDivContent.style.bottom = (kbH + 16) + "px";
        // Re-check after keyboard animation finishes for more accurate value
        setTimeout(function () {
          if (!keyboardOpen || !vv) return;
          var finalKbH = Math.round(window.innerHeight - vv.height);
          if (finalKbH > kbH) {
            iDivContent.style.bottom = (finalKbH + 16) + "px";
          }
        }, 400);
      }

      function restore() {
        clearTimeout(restoreTimer);
        restoreTimer = setTimeout(function () {
          keyboardOpen = false;
          lastKbH = 0;
          iDivContent.style.bottom = origBottom;
        }, 300);
      }

      vv.addEventListener("resize", function () {
        // Debounce to let values settle (especially during rotation)
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          var kbH = Math.round(window.innerHeight - vv.height);
          if (kbH > 100) {
            moveUp(kbH);
          } else if (keyboardOpen) {
            restore();
          }
        }, 80);
      });

      // On orientation change, recalculate if keyboard is still open
      window.addEventListener("orientationchange", function () {
        if (!keyboardOpen) return;
        setTimeout(function () {
          var kbH = Math.round(window.innerHeight - vv.height);
          if (kbH > 100) {
            moveUp(kbH);
          } else {
            restore();
          }
        }, 500); // Wait for rotation animation to finish
      });

      // Touch outside chat = keyboard dismissed
      document.addEventListener("touchstart", function (e) {
        if (keyboardOpen && !iDivContent.contains(e.target)) {
          restore();
        }
      });
    })();

    var openButton;
    if (usingIconFab() && AlanChat.theme === "default-legacy") {
      openButton = createDiv("alanActionButton", "alan_float_button");
      baseElement.appendChild(openButton);
      openButton.insertAdjacentHTML("afterbegin", iconFabSvg);
      if (positionMode === "right-bottom") {
        openButton.style.right = positionX;
        openButton.style.bottom = positionY;
      } else {
        openButton.style.left = positionX;
        openButton.style.top = positionY;
      }
      if (!isMobile.any()) openButton.style.zIndex = "1000000";

      if (getVW() > 480) {
        iDivContent.style.right = AlanChat.right;
        iDivContent.style.bottom = `${48 + 16 + parseInt(AlanChat.bottom)}px`;
      }

      openButton.addEventListener("click", function () {
        const element = document.getElementById("alanChatContent");

        if (element.classList.toggle("alan_chat_hide")) {
          element.classList.add("alan_hide_mobile");
        } else {
          element.classList.remove("alan_hide_mobile");
        }

        let e = document.getElementsByClassName("webchat-iframe")[0];
        if (e) {
          e.classList.toggle("webchat-iframe-hide");
        }
      });
    }

    document
      .getElementById("alanHeaderButton")
      .addEventListener("click", function () {
        if (AlanChat.theme === "default-new") {
          const chatIframeEl = document.querySelector(".webchat-iframe");
          const chatContentEl = document.getElementById("alanChatContent");
          const floatButtonEl = document.querySelector("#alanActionButton");
          const floatButtonTitleEl = floatButtonEl.querySelector(
            "#alanFloatButtonTitle",
          );

          if (AlanChat.isOpen) {
            document.body.classList.remove("AlanChat-open");
            chatContentEl.classList.add("alan_chat_hide");
            chatContentEl.classList.add("alan_hide_mobile");
            chatIframeEl.classList.add("webchat-iframe-hide");
            floatButtonEl.classList.remove("is-active");
            floatButtonTitleEl.innerHTML = AlanChat.title;
            if (isMobile.any()) unlockViewport();
          } else {
            document.body.classList.add("AlanChat-open");
            chatContentEl.classList.remove("alan_chat_hide");
            chatContentEl.classList.remove("alan_hide_mobile");
            chatIframeEl.classList.remove("webchat-iframe-hide");
            floatButtonEl.classList.add("is-active");
            floatButtonTitleEl.innerHTML = AlanChat.closeAssistantText;
            if (isMobile.any()) lockViewport();
          }

          AlanChat.isOpen = !AlanChat.isOpen;
          return;
        }

        var element = document.getElementById("alanChatContent");
        var isChatHidden = element.classList.toggle("alan_chat_hide");

        if (usingIconFab()) {
          if (isChatHidden) {
            element.classList.add("alan_hide_mobile");
          } else {
            element.classList.remove("alan_hide_mobile");
          }
        }

        let e = document.getElementsByClassName("webchat-iframe")[0];
        if (e) {
          e.classList.toggle("webchat-iframe-hide");
        }
      });

    // Close button (X) for when buttonHidden is active
    var closeBtn = document.querySelector(".AlanChat-closeButton");
    if (closeBtn) {
      closeBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        if (AlanChat.isOpen) {
          var chatIframeEl = document.querySelector(".webchat-iframe");
          var chatContentEl = document.getElementById("alanChatContent");
          var floatButtonEl = document.querySelector("#alanActionButton");
          var floatButtonTitleEl = floatButtonEl.querySelector("#alanFloatButtonTitle");

          document.body.classList.remove("AlanChat-open");
          chatContentEl.classList.add("alan_chat_hide");
          chatContentEl.classList.add("alan_hide_mobile");
          chatIframeEl.classList.add("webchat-iframe-hide");
          floatButtonEl.classList.remove("is-active");
          if (floatButtonTitleEl) floatButtonTitleEl.innerHTML = AlanChat.title;
          AlanChat.isOpen = false;
          if (isMobile.any()) unlockViewport();
        }
      });
    }

    {
      var isDragging = false;
      var initialX, initialY, offsetX, offsetY;

      const element = openButton || document.getElementById("alanActionButton");

      // Touch drag (mobile)
      if (usingIconFabMobile() && AlanChat.theme === "default-legacy") {
        element.addEventListener(
          "touchstart",
          (e) => {
            isDragging = true;
            var touch = e.touches[0];
            initialX = touch.clientX;
            initialY = touch.clientY;
            offsetX = parseFloat(getComputedStyle(element).left);
            offsetY = parseFloat(getComputedStyle(element).top);
            element.style.transition = "none";
            document.body.style.overflow = "hidden";
            document.body.classList.add("scroll-lock");
          },
          { passive: false },
        );

        document.addEventListener(
          "touchmove",
          (e) => {
            if (!isDragging) return;
            var touch = e.touches[0];
            const deltaX = touch.clientX - initialX;
            const deltaY = touch.clientY - initialY;

            element.style.left = offsetX + deltaX + "px";
            element.style.top = offsetY + deltaY + "px";
            e.preventDefault();
          },
          { passive: false },
        );

        document.addEventListener("touchend", () => {
          isDragging = false;
          positionX = element.style.left;
          positionY = element.style.top;
          positionMode = "left-top";
          element.style.transition = "";
          document.body.style.overflow = "auto";
          document.body.classList.remove("scroll-lock");
        });
      }

      // Mouse drag (desktop) — independent of fabType
      if (AlanChat.draggable) {
        var hasMoved = false;

        element.addEventListener("mousedown", (e) => {
          isDragging = true;
          hasMoved = false;
          initialX = e.clientX;
          initialY = e.clientY;
          const rect = element.getBoundingClientRect();
          offsetX = rect.left;
          offsetY = rect.top;
          element.style.right = "auto";
          element.style.bottom = "auto";
          element.style.left = offsetX + "px";
          element.style.top = offsetY + "px";
          element.style.transition = "none";
          e.preventDefault();
        });

        document.addEventListener("mousemove", (e) => {
          if (!isDragging) return;
          const deltaX = e.clientX - initialX;
          const deltaY = e.clientY - initialY;
          if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) hasMoved = true;
          element.style.left = offsetX + deltaX + "px";
          element.style.top = offsetY + deltaY + "px";
        });

        document.addEventListener("mouseup", () => {
          if (!isDragging) return;
          isDragging = false;
          // Clamp to 0 to prevent negative values when dragged outside viewport
          var rect = element.getBoundingClientRect();
          var newRight = Math.max(0, window.innerWidth - rect.right);
          var newBottom = Math.max(0, window.innerHeight - rect.bottom);
          element.style.left = "auto";
          element.style.top = "auto";
          element.style.right = newRight + "px";
          element.style.bottom = newBottom + "px";
          positionX = element.style.right;
          positionY = element.style.bottom;
          positionMode = "right-bottom";
          element.style.transition = "";
        });

        document.addEventListener("click", (e) => {
          if (hasMoved && (e.target === element || element.contains(e.target))) {
            e.stopImmediatePropagation();
            hasMoved = false;
          }
        }, true);
      }
    }


  };

  document
    .getElementById("alanActionButton")
    .addEventListener("click", function () {
      if (AlanChat.theme === "default-new") {
        if (!AlanChat.isLoaded) {
          AlanChat.loadIframe();
          AlanChat.isLoaded = true;
        }
        const chatIframeEl = document.querySelector(".webchat-iframe");
        const chatContentEl = document.getElementById("alanChatContent");
        const floatButtonEl = document.querySelector("#alanActionButton");
        const floatButtonTitleEl = floatButtonEl.querySelector(
          "#alanFloatButtonTitle",
        );

        if (AlanChat.isOpen) {
          document.body.classList.remove("AlanChat-open");
          chatContentEl.classList.add("alan_chat_hide");
          chatContentEl.classList.add("alan_hide_mobile");
          chatIframeEl.classList.add("webchat-iframe-hide");
          this.classList.remove("is-active");
          floatButtonTitleEl.innerHTML = AlanChat.title;
          if (isMobile.any()) unlockViewport();
        } else {
          document.body.classList.add("AlanChat-open");
          chatContentEl.classList.remove("alan_chat_hide");
          chatContentEl.classList.remove("alan_hide_mobile");
          chatIframeEl.classList.remove("webchat-iframe-hide");
          this.classList.add("is-active");
          floatButtonTitleEl.innerHTML = AlanChat.closeAssistantText;
          if (isMobile.any()) lockViewport();
        }

        AlanChat.isOpen = !AlanChat.isOpen;
        return;
      }

      if (AlanChat.runScripts) {
        document.getElementById("alanActionButton").innerHTML =
          '<svg version="1.1" id="L7" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 100 100" enable-background="new 0 0 100 100" xml:space="preserve"><path fill="#fff" d="M31.6,3.5C5.9,13.6-6.6,42.7,3.5,68.4c10.1,25.7,39.2,38.3,64.9,28.1l-3.1-7.9c-21.3,8.4-45.4-2-53.8-23.3    c-8.4-21.3,2-45.4,23.3-53.8L31.6,3.5z"><animateTransform attributeName="transform" attributeType="XML" type="rotate" dur="2s" from="0 50 50" to="360 50 50" repeatCount="indefinite"></animateTransform> </path> <path fill="#fff" d="M42.3,39.6c5.7-4.3,13.9-3.1,18.1,2.7c4.3,5.7,3.1,13.9-2.7,18.1l4.1,5.5c8.8-6.5,10.6-19,4.1-27.7    c-6.5-8.8-19-10.6-27.7-4.1L42.3,39.6z"> <animateTransform attributeName="transform" attributeType="XML" type="rotate" dur="1s" from="0 50 50" to="-360 50 50" repeatCount="indefinite"></animateTransform>  </path> <path fill="#fff" d="M82,35.7C74.1,18,53.4,10.1,35.7,18S10.1,46.6,18,64.3l7.6-3.4c-6-13.5,0-29.3,13.5-35.3s29.3,0,35.3,13.5    L82,35.7z"> <animateTransform attributeName="transform" attributeType="XML" type="rotate" dur="2s" from="0 50 50" to="360 50 50" repeatCount="indefinite"></animateTransform>  </path></svg>';
        document.getElementById("alanActionButton").style = "padding: 10px";

        AlanChat.runScripts();
      } else {
        AlanChat.loadIframe();
        if (usingIconFab() && AlanChat.theme === "default-legacy") {
          const chatContent = document.getElementById("alanChatContent");
          if (chatContent) {
            chatContent.classList.remove("alan_chat_hide");
            chatContent.classList.remove("alan_hide_mobile");
          }
          const iframe = document.querySelector(".webchat-iframe");
          if (iframe) iframe.classList.remove("webchat-iframe-hide");
        }
      }
    });


};

//utils
function customizeOrbAnimation(animation, color) {
  const animationData =
    typeof structuredClone === "function"
      ? structuredClone(animation)
      : JSON.parse(JSON.stringify(animation));

  const newPrimaryColor = hexToLottieColor(lighten(color, 20));
  const newHighlightColor = hexToLottieColor(lighten(color, 90));

  animationData.assets[6].layers[6].shapes[0].it[1].c.k =
    newPrimaryColor;
  animationData.assets[7].layers[0].shapes[0].it[1].c.k =
    newPrimaryColor;
  animationData.assets[9].layers[0].shapes[0].it[1].c.k =
    newPrimaryColor;
  animationData.assets[10].layers[0].shapes[0].it[1].c.k =
    newPrimaryColor;

  animationData.assets[8].layers[0].shapes[0].it[1].c.k =
    newHighlightColor;
  animationData.assets[11].layers[0].shapes[0].it[1].c.k =
    newHighlightColor;
  animationData.assets[12].layers[0].shapes[0].it[1].c.k =
    newHighlightColor;
  animationData.assets[13].layers[0].shapes[0].it[1].c.k =
    newHighlightColor;

  return animationData;
};


function hexToLottieColor(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  if (!result) {
    return [0, 0, 0];
  }

  const r = parseInt(result[1], 16) / 255;
  const g = parseInt(result[2], 16) / 255;
  const b = parseInt(result[3], 16) / 255;

  return [r, g, b];
};

function colorToRgb(color) {
  if (color.startsWith("#")) {
    const hex = color.replace("#", "");
    const fullHex =
      hex.length === 3
        ? hex.split("").map((c) => c + c).join("")
        : hex;

    if (fullHex.length !== 6) return null;

    return [
      parseInt(fullHex.substring(0, 2), 16),
      parseInt(fullHex.substring(2, 4), 16),
      parseInt(fullHex.substring(4, 6), 16),
    ];
  }

  const d = document.createElement("div");
  d.style.color = color;
  document.body.appendChild(d);
  const rgbString = window.getComputedStyle(d).color;
  document.body.removeChild(d);

  const rgbMatch = rgbString.match(/rgb\((\d+), (\d+), (\d+)\)/);
  if (rgbMatch) {
    return [
      parseInt(rgbMatch[1]),
      parseInt(rgbMatch[2]),
      parseInt(rgbMatch[3]),
    ];
  }

  return null;
};

function lighten(color, percent) {
  const rgb = colorToRgb(color);
  if (!rgb) return color;

  const [r, g, b] = rgb;
  const amount = percent / 100;

  const newR = Math.min(255, Math.round(r + (255 - r) * amount));
  const newG = Math.min(255, Math.round(g + (255 - g) * amount));
  const newB = Math.min(255, Math.round(b + (255 - b) * amount));

  const toHex = (n) => n.toString(16).padStart(2, "0");

  return `#${toHex(newR)}${toHex(newG)}${toHex(newB)}`;
}
