document.addEventListener('DOMContentLoaded', function () {
  const gffChatBot = document.getElementById('ContenedorChat');
  const floatingMenu = document.getElementById('floatingMenu');
  
  // Si no hay ningún contenedor, no hacemos nada
  if (!gffChatBot && !floatingMenu) return;

  // 1. Obtener configuraciones de ambos
  const config = {
    // Talkme (Ficochat)
    idBot: (gffChatBot || floatingMenu)?.getAttribute('data-id-bot'),
    idBotRedes: (gffChatBot || floatingMenu)?.getAttribute('data-id-bot-redes'),
    idEmpresa: (gffChatBot || floatingMenu)?.getAttribute('data-id-empresa'),
    fases: (gffChatBot || floatingMenu)?.getAttribute('data-fases-bot'),
    urlEmpresaTalkme: (gffChatBot || floatingMenu)?.getAttribute('data-url-empresa'),
    prefijo: (gffChatBot || floatingMenu)?.getAttribute('data-prefijo-bot'),
    urlWebChatTalkme: (gffChatBot || floatingMenu)?.getAttribute('data-url-webchat'),
    // Delto (Sara)
    token: (gffChatBot || floatingMenu)?.getAttribute('data-token-delto'),
    urlWebChatDelto: ((gffChatBot || floatingMenu)?.getAttribute('data-url-webchat-delto') || "https://library.cxsuite.cloud/sdk/sdkv2.1.5.js").trim(),
    urlEmpresaDelto: ((gffChatBot || floatingMenu)?.getAttribute('data-url-empresa-delto') || "https://conversational-chat-v2.cxsuite.cloud").trim(),
    subsidiary: (gffChatBot || floatingMenu)?.getAttribute('data-subsidiary') || 'hn'
  };

  // SRI por versión del SDK Sara/Delto (hash + URL deben ir en el mismo deploy).
  // crossorigin=anonymous es obligatorio para que el navegador aplique integrity.
  const DELTO_SDK_SRI = {
    "https://library.cxsuite.cloud/sdk/sdkv2.1.5.js":
      "sha384-ac/u1aIWKWXRxcyTVTc9OX6oGHJvHjVEXqgCC29Dk0O5Cg8YXYFdLdmCzn+wx8CH"
  };

  function resolveDeltoSri(url) {
    if (!url) return null;
    const normalized = String(url).trim();
    if (DELTO_SDK_SRI[normalized]) return DELTO_SDK_SRI[normalized];
    // Match por path por si hay espacios o query residual en el diálogo AEM
    try {
      const path = new URL(normalized).pathname;
      const entry = Object.entries(DELTO_SDK_SRI).find(([known]) => {
        try {
          return new URL(known).pathname === path;
        } catch (_) {
          return false;
        }
      });
      return entry ? entry[1] : null;
    } catch (_) {
      return null;
    }
  }

  // 2. Función para cargar scripts
  function loadScript(url, callback) {
    if (document.querySelector(`script[src="${url}"]`)) {
      if (callback) callback();
      return;
    }
    const s = document.createElement('script');
    s.type = 'text/javascript';
    s.src = url;

    const integrity = resolveDeltoSri(url);
    if (integrity) {
      s.integrity = integrity;
      s.crossOrigin = "anonymous";
      s.referrerPolicy = "no-referrer";
    }

    s.onload = callback;
    s.onerror = () =>
      console.error(
        "[Chatbot] Error cargando SDK (revisar URL/SRI/CORS):",
        url,
        integrity ? "con integrity" : "sin integrity"
      );
    document.head.appendChild(s);
  }

  // --- INICIALIZACIÓN FICOCHAT (TALKME) ---
  function initTalkme(token) {
    if (!config.urlWebChatTalkme) return;
    
    // Cargar jQuery (Talkme lo necesita)
    loadScript('https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js', function () {
      loadScript(config.urlWebChatTalkme, function () {
        const $local = jQuery.noConflict();
        $local(document).ready(function () {
          const talkmeConfig = {
            id_bot: config.idBot,
            id_bot_redes: config.idBotRedes,
            id_empresa: config.idEmpresa,
            token: token,
            fases: config.fases,
            url_empresa: config.urlEmpresaTalkme,
            contenedor: $local('#ContenedorChat').length ? $local('#ContenedorChat') : $local(document.body),
            prefijo: config.prefijo,
            install_log: true
          };
          
          if (typeof initCstkChat === 'function') {
            initCstkChat(talkmeConfig);
            console.log("[Chatbot] Ficochat (Talkme) inicializado correctamente.");
          }
        });
      });
    });
  }

  // --- INICIALIZACIÓN SARA (DELTO) ---
  function initDelto() {
    if (!config.token) return;

    loadScript(config.urlWebChatDelto, function () {
      if (typeof DeltoSDK !== "undefined") {
        // Usar la lógica de inicialización detallada del proveedor
        const chatUrl = `${config.urlEmpresaDelto}/?token=${config.token}&accessChannel=Public-Web&documentnumber=123456&subsidiary=${config.subsidiary}&target=default&lang=es`;
        
        DeltoSDK.search(chatUrl);
        
        // Parámetros de sesión y apariencia
        DeltoSDK.setParameter("persistGuestUser", true);
        DeltoSDK.setParameter("persistMessages", true);
        DeltoSDK.setTheme("default-new");
        DeltoSDK.setTitle("Ayuda en línea");
        DeltoSDK.setCloseAssistantText("Cerrar chat");
        DeltoSDK.setAccentColor("#0058CB");
        
        // Estética premium del botón (aunque esté oculto, por si se activa)
        DeltoSDK.setFloatButtonColors({
          startColor: "#E8F0FE",
          endColor: "#FFFFFF",
          outlineColor: "rgba(60, 106, 255, 0.31)"
        });
        DeltoSDK.setFloatButtonTextColor("#0058CB");
        
        // Posicionamiento
        DeltoSDK.setRight("24px");
        DeltoSDK.setBottom("24px");
        
        // Ocultar botón nativo y arrancar
        DeltoSDK.setButtonHidden(true);
        DeltoSDK.start();
        
        console.log("[Chatbot] Sara (Delto) inicializado con parámetros completos y estética premium.");
      }
    });
  }

  // --- EJECUCIÓN ---
  
  // 1. Ficochat: Primero pedimos el token al servlet
  if ((gffChatBot || floatingMenu) && config.urlWebChatTalkme) {
    fetch('/bin/service/token.json')
      .then(res => res.json())
      .then(json => {
        if (json.token) initTalkme(json.token);
      })
      .catch(err => console.error('[Chatbot] Error obteniendo token para Talkme:', err));
  }

  // 2. Sara: Inicializar directamente con el token del componente
  if (config.token) {
    initDelto();
  }
});