(function($) {
  'use strict';

  const DESKTOP_BREAKPOINT = 1020;

  // Función para cargar el CSS de Swiper si no está cargado
  function loadSwiperCSS() {
    const isCssLoaded = $('link[href*="swiper-bundle.min.css"]').length > 0;
    if (!isCssLoaded) {
      $('<link>', {
        rel: 'stylesheet',
        href: 'https://unpkg.com/swiper/swiper-bundle.min.css'
      }).appendTo('head');
    }
  }

  // Función para cargar el JS de Swiper si no está cargado
  function loadSwiperJS(callback) {
    const isScriptLoaded = $('script[src*="swiper-bundle.min.js"]').length > 0;
    if (!isScriptLoaded) {
      $.getScript('https://unpkg.com/swiper/swiper-bundle.min.js', callback);
    } else {
      callback();
    }
  }

  // Inicializar Swiper para mobile
  function initSwiper() {
    if ($(window).width() <= DESKTOP_BREAKPOINT) {
      requestAnimationFrame(function() {
        const swiper = new Swiper('.gff-swiper-news', {
          slidesPerView: 'auto',
          spaceBetween: 10,
          pagination: {
            el: '.gff-swiper-news__pagination',
            clickable: true
          },
          navigation: {
            nextEl: '.gff-swiper-news__button-next',
            prevEl: '.gff-swiper-news__button-prev'
          }
        });

        swiper.on('touchEnd', function() {
          if (swiper.isEnd && swiper.touches.diff < 0) {
            setTimeout(function() {
              swiper.slideTo(0, 300);
            }, 300);
          }
        });
      });
    }
  }

  // Obtener longitud máxima de descripción según viewport
  function getMaxLength() {
    return $(window).width() <= 800 ? 85 : 115;
  }

  // Actualizar contenido de las cards desde el servicio
  function updateCards() {
    $('.gff-news-card').each(function() {
      const $card = $(this);
      const $description = $card.find('.gff-news-card__description');
      const urlAttribute = $description.data('url-page');
      const url = '/bin/services/getPageTags?path=' + urlAttribute;

      $.getJSON(url)
        .done(function(data) {
          const tiempoDeLectura = (data['tiempo-de-lectura']?.replaceAll('-', ' ')) || '5 min';
          const pageTitle = data.pageTitle || '';
          const imagePath = data.imagePath || '';
          const tagline = (data.tagline?.replaceAll('-', ' ')) || '';
          const description = data.description || '';
          const maxLength = getMaxLength();

          // Actualizar tiempo de lectura
          $card.find('.gff-news-card__time').html(
            '<img src="/content/dam/grupo-ficohsa-site/iconos/icon-ojos.svg" alt="Tiempo de lectura" class="gff-news-card__icon">' + tiempoDeLectura
          );

          // Actualizar título, tagline e imagen
          $card.find('.gff-news-card__title').html(pageTitle);
          $card.find('.tagline-ficohsa-text').html(tagline);
          $card.find('.gff-news-card__image').attr('src', imagePath);

          // Actualizar descripción con truncamiento
          const $linkElement = $description.find('.gff-news-card__link');
          const linkHtml = $linkElement.length ? $linkElement[0].outerHTML : '';
          const truncatedDescription = description.length > maxLength 
            ? description.slice(0, maxLength) + '...' 
            : description;

          $description.html(truncatedDescription + linkHtml);
        })
        .fail(function(error) {
          console.error('Error al obtener los datos:', error);
        });
    });
  }

  // Configurar tagline background
  function initTaglineBackground() {
    const $tagline = $('.gff-news-cards-tagline');
    if ($tagline.length) {
      const bgColor = $tagline.data('bg-tagline');
      $tagline.css('backgroundColor', bgColor);
    }
  }

  // Configurar filtro de país en el anchor
  function initCountryFilter() {
    const $anchor = $('a[data-country]');
    if ($anchor.length) {
      const country = $anchor.data('country');
      let href = $anchor.attr('href');
      if (href) {
        const separator = href.includes('?') ? '&' : '?';
        href += separator + 'filter=' + encodeURIComponent(country);
        $anchor.attr('href', href);
      }
    }
  }

  // Funcionalidad Ver más/Ver menos para Desktop
  function initToggleCards() {
    $('.gff-news-cards-container').each(function() {
      const $container = $(this);
      const maxVisible = parseInt($container.data('max-visible'));
      const $slides = $container.find('.gff-swiper-news__slide');
      const $toggleBtn = $container.find('.gff-news-cards__toggle-btn');
      const $toggleText = $container.find('.gff-news-cards__toggle-text');
      const $toggleArrow = $container.find('.gff-news-cards__toggle-arrow');

      // Si no hay maxVisible configurado o hay menos slides que el máximo
      if (!maxVisible || !$toggleBtn.length || $slides.length <= maxVisible) {
        $toggleBtn.hide();
        $slides.removeClass('gff-news-cards__slide-hidden');
        return;
      }

      let isExpanded = false;

      function updateVisibility() {
        const isDesktop = $(window).width() > DESKTOP_BREAKPOINT;

        if (isDesktop) {
          // Mostrar/ocultar botón según cantidad de slides
          $toggleBtn.toggle($slides.length > maxVisible);

          // Mostrar/ocultar slides según estado
          $slides.each(function(index) {
            const $slide = $(this);
            if (index >= maxVisible && !isExpanded) {
              $slide.addClass('gff-news-cards__slide-hidden');
            } else {
              $slide.removeClass('gff-news-cards__slide-hidden');
            }
          });

          // Actualizar texto y flecha
          $toggleText.text(isExpanded ? 'Ver menos' : 'Ver más');
          $toggleArrow.css('transform', isExpanded ? 'rotate(180deg)' : 'rotate(0deg)');
        } else {
          // En mobile, mostrar todas y ocultar el botón
          $toggleBtn.hide();
          $slides.removeClass('gff-news-cards__slide-hidden');
        }
      }

      // Click en botón toggle
      $toggleBtn.on('click', function() {
        isExpanded = !isExpanded;
        updateVisibility();
      });

      // Inicializar visibilidad
      updateVisibility();

      // Actualizar en resize
      $(window).on('resize', updateVisibility);
    });
  }

  // Inicialización cuando el DOM está listo
  $(document).ready(function() {
    // Cargar Swiper
    loadSwiperCSS();
    loadSwiperJS(function() {
      requestAnimationFrame(initSwiper);
      $(window).on('resize', function() {
        requestAnimationFrame(initSwiper);
      });
    });

    // Inicializar funcionalidades
    updateCards();
    initTaglineBackground();
    initCountryFilter();
    initToggleCards();

    // Re-aplicar updateCards en resize
    $(window).on('resize', updateCards);
  });

})(jQuery);