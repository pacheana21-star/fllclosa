document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.gff-card_country-component a').forEach(link => {
        const card = link.closest('.gff-card_country-component');
        const selectable = card.closest('.gff-card-country-general--selectable');
        if (selectable || (link.hasAttribute('href') && link.getAttribute('href') !== "")) {
            card.classList.add('has-link');
        } else {
            card.classList.remove('has-link');
        }
    });

    /* -------------------------------------------------
       MODO SELECCIÓN DE CONTENIDO
       La card no navega: emite el tag que filtra el
       listado inferior de la misma página.
    ------------------------------------------------- */

    const CARD_EVENT = 'gff:cards-country:change';
    const COUNTRY_EVENT = 'gff:country:change';
    const CARD_QUERY_PARAM = 'card';

    const buildDetail = (group, card) => ({
        source: group,
        sectionId: group.dataset.sectionId || '',
        contentTargetId: card.dataset.contentTargetId || '',
        filterId: card.dataset.filterId || '',
        showCategories: card.dataset.showCategories === 'true',
        listTitle: card.dataset.listTitle || '',
        listIcon: card.dataset.listIcon || '',
        label: (card.querySelector('.gff-card_country-component_text-title')?.textContent || '').trim()
    });

    const emitSelection = (group, card) => {
        document.dispatchEvent(new CustomEvent(CARD_EVENT, {
            detail: buildDetail(group, card)
        }));
    };

    const selectCard = (group, card, { emit = true, syncUrl = false } = {}) => {
        group.querySelectorAll('.gff-card_country-component').forEach(item => {
            const isTarget = item === card;
            item.classList.toggle('is-active', isTarget);
            const anchor = item.querySelector('a');
            if (anchor) anchor.setAttribute('aria-selected', isTarget ? 'true' : 'false');

            const contentTargetId = item.dataset.contentTargetId;
            const contentTarget = contentTargetId && document.getElementById(contentTargetId);
            if (contentTarget) contentTarget.style.display = isTarget ? '' : 'none';
        });

        if (syncUrl && card.dataset.filterId) {
            const url = new URL(window.location);
            url.searchParams.set(CARD_QUERY_PARAM, card.dataset.filterId);
            window.history.replaceState({}, '', url);
        }

        if (emit) emitSelection(group, card);
    };

    const initSelectableGroup = (group) => {
        const cards = Array.from(group.querySelectorAll('.gff-card_country-component'));
        if (!cards.length) return;

        cards.forEach((card, index) => {
            const anchor = card.querySelector('a');
            if (!anchor) return;

            anchor.setAttribute('role', 'tab');
            anchor.setAttribute('tabindex', '0');
            anchor.removeAttribute('href');

            anchor.addEventListener('click', (event) => {
                event.preventDefault();
                selectCard(group, card, { syncUrl: true });
            });

            anchor.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    selectCard(group, card, { syncUrl: true });
                    return;
                }

                const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
                if (offset === 0) return;

                event.preventDefault();
                const next = cards[(index + offset + cards.length) % cards.length];
                next.querySelector('a')?.focus();
                selectCard(group, next, { syncUrl: true });
            });
        });

        const requestedCard = new URLSearchParams(window.location.search).get(CARD_QUERY_PARAM);
        const initial =
            (requestedCard && cards.find(card => card.dataset.filterId === requestedCard)) ||
            cards.find(card => card.classList.contains('is-active')) ||
            cards[0];

        selectCard(group, initial, { emit: false });
        group.dataset.ready = 'true';
    };

    const selectableGroups = Array.from(
        document.querySelectorAll('.gff-card-country-general--selectable')
    );

    selectableGroups.forEach(initSelectableGroup);

    const emitActiveSelection = (group) => {
        const active = group.querySelector('.gff-card_country-component.is-active');
        if (active) emitSelection(group, active);
    };

    selectableGroups.forEach(emitActiveSelection);

    // Al cambiar de país, el bloque visible reemite su selección para resincronizar su listado.
    document.addEventListener(COUNTRY_EVENT, (event) => {
        const panel = event.detail?.panel;
        if (!panel) return;

        panel.querySelectorAll('.gff-card-country-general--selectable').forEach(emitActiveSelection);
    });

    const GTM_DELAY_MS = 400;

    const pushGtmAndNavigate = (link, payload) => {
        link.addEventListener('click', function (e) {
            const href = this.getAttribute("href");
            if (!href || href === "#") return;
            if (e.ctrlKey || e.metaKey || e.button === 1) return;

            e.preventDefault();

            const dataLayerName = window.dataLayerObjName || 'dataLayer';
            window[dataLayerName] = window[dataLayerName] || [];
            window[dataLayerName].push(payload);

            const openInNewTab = this.getAttribute("target") === "_blank";
            setTimeout(function () {
                if (openInNewTab) {
                    window.open(href, "_blank");
                } else {
                    window.location.href = href;
                }
            }, GTM_DELAY_MS);
        });
    };

    const setupGTMTracking = () => {
        const path = window.location.pathname || "";
        const cards = document.querySelectorAll('.gff-card-country-general:not(.gff-card-country-general--selectable) .gff-card_country-component');

        // Programa ahorro combustible (cards 1 y 2 por índice)
        if (path.indexOf("programa-ahorro-combustible") !== -1) {
            cards.forEach((card, index) => {
                if (index >= 2) return;
                const link = card.querySelector('a');
                if (!link) return;

                pushGtmAndNavigate(link, {
                    event: 'click',
                    product_name: index === 0 ? "Cuenta de Ahorros" : "Tarjetas de Credito",
                    step_name: 'N/A',
                    platform: 'DXP',
                    product_category: 'Botón',
                    product_type: 'Ahorro combustible',
                    partner: 'N/A',
                    country: 'HN',
                });
            });
            return;
        }

        // Débitos automáticos: solo la card "Gestiones en línea"
        if (path.indexOf("debitos-automaticos") !== -1) {
            cards.forEach((card) => {
                const title = (card.querySelector('.gff-card_country-component_text-title')?.textContent || "")
                    .trim()
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "");
                if (title !== "gestiones en linea") return;

                const link = card.querySelector('a');
                if (!link) return;

                pushGtmAndNavigate(link, {
                    event: 'click',
                    product_name: 'Promociones Ficohsa',
                    step_name: 'Gestiones en línea',
                    platform: 'DXP',
                    product_category: 'N/A',
                    product_type: 'Débitos Automáticos ',
                    partner: 'N/A',
                    country: 'HN',
                });
            });
        }
    };

    setupGTMTracking();
});
